{
  "name": "kairos",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "llm:smoke": "node --env-file=.env --conditions=react-server --import tsx scripts/llm-smoke.ts",
    "test": "node --conditions=react-server --import tsx --test tests/*.test.ts",
    "check:boundaries": "node scripts/check-boundaries.mjs",
    "seed": "node --env-file=.env --conditions=react-server --import tsx scripts/seed.ts",
    "agent:sweep": "node --env-file=.env --conditions=react-server --import tsx scripts/agent-sweep.ts",
    "sandbox:cleanup": "node --env-file=.env --conditions=react-server --import tsx scripts/sandbox-cleanup.ts",
    "agent:draft": "node --env-file=.env --conditions=react-server --import tsx scripts/agent-draft.ts",
    "agent:run": "node --env-file=.env --conditions=react-server --import tsx scripts/agent-run.ts",
    "agent:replay": "node --env-file=.env --conditions=react-server --import tsx scripts/agent-replay.ts",
    "executor:preview": "node --env-file=.env --conditions=react-server --import tsx scripts/executor-preview.ts",
    "chat": "node --env-file=.env --conditions=react-server --import tsx scripts/chat.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.6.0",
    "better-sqlite3": "^13.0.3",
    "next": "^16.4.5",
    "paypal": "git+https://github.com/context-plugins/paypal-typescript-sdk.git#5d0df8a8817e5fdf2e2cd48e68f790ea4730aab2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "server-only": "^0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
