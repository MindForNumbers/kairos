PAYPAL_CLIENT_ID=your_client_id_here
PAYPAL_CLIENT_SECRET=your_secret_here
PAYPAL_ENVIRONMENT=SANDBOX
ANTHROPIC_API_KEY=
# Webhook ID from Developer Dashboard → your app → Webhooks (for /api/webhooks/paypal)
PAYPAL_WEBHOOK_ID=
# SQLite file for proposals, approvals, send ledger and audit log (default: data/kairos.db)
KAIROS_DB_PATH=
# Business clock: timezone for overdue math, daily cap and quiet hours
KAIROS_TIMEZONE=America/Los_Angeles
# Optional: pretend "now" is this instant (ISO 8601), e.g. 2026-12-15T17:00:00Z. Clock keeps ticking from it.
KAIROS_NOW=
# Four distinct sandbox personal-account emails, comma-separated (npm run demo:reset, the 14:30 UTC cron reset, npm run seed).
# Pay-in-parts limits and the Director's 14-day cash target are owner settings on /settings/incentives, not env vars.
KAIROS_SEED_EMAILS=
# Model for the critic (Stage 4). Must differ from the drafter (claude-haiku-5-5).
KAIROS_CRITIC_MODEL=claude-sonnet-5-5
# Spend caps for model calls (USD). Each call is checked at its worst-case cost before it runs.
KAIROS_RUN_COST_CAP=0.50
KAIROS_DAILY_COST_CAP=5.00
# Executor (Stage 6). Anything but 1 = dry run: every check runs, PayPal is never called.
KAIROS_EXECUTOR_ENABLED=
# Reminders per business day, agent + manual (default 10)
KAIROS_DAILY_SEND_CAP=10
# No agent sends in this local window (HH:MM, 24h, KAIROS_TIMEZONE)
KAIROS_QUIET_START=21:00
KAIROS_QUIET_END=08:00
# Emergency stop file (default ./KILL): touch it to halt all sends
KAIROS_KILL_FILE=
# Kairos chat (Stage 7): model and per-message spend cap (USD). Shares KAIROS_DAILY_COST_CAP.
KAIROS_CHAT_MODEL=claude-haiku-5-5
KAIROS_CHAT_TURN_COST_CAP=0.05

# Invoice from photo/voice: extractor, reviewer, and per-intake spend cap (USD). Shares KAIROS_DAILY_COST_CAP.
KAIROS_INTAKE_MODEL=claude-sonnet-5-5
KAIROS_INTAKE_REVIEW_MODEL=claude-haiku-5-5
KAIROS_INTAKE_COST_CAP=0.15

# App-wide login password (12+ characters). Changing it signs everyone out.
KAIROS_ADMIN_PASSWORD=
# Bearer secret for /api/cron/agent-run and /api/cron/demo-reset (32+ characters, e.g. `openssl rand -hex 32`).
KAIROS_CRON_SECRET=

# AG Studio licence key for /reports (optional; without it the page shows a watermark). Sent to the browser, so it is public.
AG_STUDIO_LICENSE_KEY=
