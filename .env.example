# Kairos environment variables: every variable the code reads, with no values.
# Copy to .env (git-ignored) and fill in what you need. An empty value means "use the default" (in brackets).
# Never commit real values.

# ---- PayPal (REST app from the Developer Dashboard) ----
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# SANDBOX or LIVE [SANDBOX]. Demo reset and seed scripts refuse to run on LIVE.
PAYPAL_ENVIRONMENT=
# ID of the webhook registered at https://<host>/api/webhooks/invoices (/api/webhooks/paypal is the same handler).
# Subscribe to INVOICING.INVOICE.PAID, .CANCELLED, .REFUNDED and .UPDATED. Without it, webhook events are rejected.
PAYPAL_WEBHOOK_ID=

# ---- Anthropic ----
ANTHROPIC_API_KEY=
# Chat, briefing wording and the /reports assistant [claude-haiku-5-5]
KAIROS_CHAT_MODEL=
# Critic for drafted reminders; must differ from the drafter (claude-haiku-5-5) [claude-sonnet-5-5]
KAIROS_CRITIC_MODEL=
# Invoice from photo/voice: extractor [claude-sonnet-5-5] and reviewer [claude-haiku-5-5]
KAIROS_INTAKE_MODEL=
KAIROS_INTAKE_REVIEW_MODEL=

# ---- Spend caps for model calls, USD (each call is checked at its worst-case cost before it runs) ----
# Per agent run [0.50]
KAIROS_RUN_COST_CAP=
# Per business day, shared by everything [5.00]
KAIROS_DAILY_COST_CAP=
# Per chat message / reports-assistant turn [0.05]
KAIROS_CHAT_TURN_COST_CAP=
# Per photo/voice intake [0.15]
KAIROS_INTAKE_COST_CAP=

# ---- Access ----
# App-wide login password, 12+ characters. Changing it signs everyone out.
KAIROS_ADMIN_PASSWORD=
# Bearer secret for POST /api/cron/agent-run and /api/cron/demo-reset, 32+ characters (e.g. `openssl rand -hex 32`).
KAIROS_CRON_SECRET=

# ---- Storage and clock ----
# SQLite file for proposals, approvals, send ledger, holds, policies, chat and audit log [data/kairos.db].
# On Render, point this at a file on the persistent disk.
KAIROS_DB_PATH=
# Business timezone for overdue math, daily caps and quiet hours [America/Los_Angeles]
KAIROS_TIMEZONE=
# Optional: pretend "now" is this ISO 8601 instant, e.g. 2026-12-15T17:00:00Z; the clock keeps ticking from it.
KAIROS_NOW=
# Optional (tests): 1 stops the clock at KAIROS_NOW.
KAIROS_NOW_FROZEN=

# ---- Sending (the executor) ----
# 1 = really send through PayPal. Anything else = dry run: every check runs, PayPal is never called. [dry run]
KAIROS_EXECUTOR_ENABLED=
# Reminders per business day, agent + manual [10]
KAIROS_DAILY_SEND_CAP=
# No agent sends in this local window, HH:MM 24h in KAIROS_TIMEZONE [21:00 → 08:00]
KAIROS_QUIET_START=
KAIROS_QUIET_END=
# Emergency stop: if this file exists, nothing is sent [./KILL]
KAIROS_KILL_FILE=

# ---- Demo data ----
# Four distinct sandbox personal-account emails, comma-separated (daily demo reset, npm run demo:reset, npm run seed).
KAIROS_SEED_EMAILS=
# Invoice number prefix for seeded demo invoices [TS]
KAIROS_SEED_PREFIX=
# Pay-in-parts limits and the Director's 14-day cash target are owner settings on /settings/incentives, not env vars.

# ---- Reports (/reports, AG Studio) ----
# AG Studio licence key. Optional: without it the page shows a watermark. Sent to the browser, so treat it as public.
AG_STUDIO_LICENSE_KEY=
# The plain-English report assistant. Set to off to hide it; also hidden without ANTHROPIC_API_KEY. [on]
KAIROS_REPORTS_AI=
