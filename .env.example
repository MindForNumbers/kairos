PAYPAL_CLIENT_ID=your_client_id_here
PAYPAL_CLIENT_SECRET=your_secret_here
PAYPAL_ENVIRONMENT=SANDBOX
ANTHROPIC_API_KEY=
# Webhook ID from Developer Dashboard → your app → Webhooks (for /api/webhooks/paypal)
PAYPAL_WEBHOOK_ID=
# SQLite file for proposals, approvals, send ledger and audit log (default: data/kairos.db)
KAIROS_DB_PATH=
# Business clock: timezone for overdue math, daily cap and quiet hours
KAIROS_TIMEZONE=America/Los_Angeles
# Optional: pretend "now" is this instant (ISO 8601), e.g. 2026-12-15T17:00:00Z. Clock keeps ticking from it.
KAIROS_NOW=
# Sandbox personal account email that `npm run seed` invoices
KAIROS_SEED_EMAIL=
# Model for the critic (Stage 4). Must differ from the drafter (claude-haiku-5-5).
KAIROS_CRITIC_MODEL=claude-sonnet-5-5
# Spend caps for model calls (USD). Each call is checked at its worst-case cost before it runs.
KAIROS_RUN_COST_CAP=0.50
KAIROS_DAILY_COST_CAP=5.00
# Executor (Stage 6). Anything but 1 = dry run: every check runs, PayPal is never called.
KAIROS_EXECUTOR_ENABLED=
# Reminders per business day, agent + manual (default 10)
KAIROS_DAILY_SEND_CAP=10
# No agent sends in this local window (HH:MM, 24h, KAIROS_TIMEZONE)
KAIROS_QUIET_START=21:00
KAIROS_QUIET_END=08:00
# Emergency stop file (default ./KILL): touch it to halt all sends
KAIROS_KILL_FILE=
